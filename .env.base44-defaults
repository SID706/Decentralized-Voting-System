# Committed defaults for the Base44 sandbox so the app boots with no credentials.
# Values here are placeholders, never secrets. Platform secrets from
# /run/base44/app.env are loaded AFTER this file and override anything here.
#
# Leave empty to run the interface against a local demo ledger (stored in the
# browser). Fill in the address printed by `npx hardhat run scripts/deploy.js`
# to vote against a real contract.
REACT_APP_CONTRACT_ADDRESS=
REACT_APP_NETWORK_LABEL=Local Ganache
